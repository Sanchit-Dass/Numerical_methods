
#include <iostream>
#include <cmath>
#include <iomanip>
using namespace std;

// Poisson Equation: uxx + uyy = 4
double f(double, double)
{
    return 4.0;
}

int main()
{
    double a[5][5] = {0}, b[5][5] = {0}, tol;
    double h = 0.25, x, y;
    int i, j, k = 1, iteration = 0;

    cout << "Enter the tolerance error: " << endl;
    cin >> tol;

    // Boundary conditions
    for (i = 0; i <= 4; i++)
    {
        x = i * h;
        a[i][0] = x*x;
        a[i][4] = x*x + 1;
    }

    for (j = 0; j <= 4; j++)
    {
        y = j * h;
        a[0][j] = y*y;
        a[4][j] = 1 + y*y;
    }

    // Jacobi iteration
    while (k != 0 && iteration < 10000)
    {
        k = 0;

        for (i = 1; i <= 3; i++)
        {
            for (j = 1; j <= 3; j++)
            {
                x = i * h;
                y = j * h;

                // Five-point finite difference formula
                b[i][j] = 0.25 * (a[i-1][j] + a[i+1][j]
                                    + a[i][j-1] + a[i][j+1]
                                    - h*h*f(x,y));

                if (fabs(b[i][j] - a[i][j]) > tol)
                {
                    k = 1;
                }
            }
        }

        // Update all interior values
        for (i = 1; i <= 3; i++)
        {
            for (j = 1; j <= 3; j++)
            {
                a[i][j] = b[i][j];
            }
        }

        iteration++;
    }

    if (k != 0)
    {
        cout << "Method did not converge!" << endl;
        return 1;
    }

    cout << "Number of iterations = " << iteration << endl;
    cout << "Solution of Poisson equation (Jacobi method):" << endl;

    cout << fixed << setprecision(6);

    for (i = 0; i <= 4; i++)
    {
        for (j = 0; j <= 4; j++)
        {
            cout << setw(12) << a[i][j] << " ";
        }
        cout << endl;
    }

    return 0;
}
