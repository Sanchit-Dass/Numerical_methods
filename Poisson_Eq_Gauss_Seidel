
#include <iostream>
#include <cmath>
#include <iomanip>
using namespace std;

// Poisson equation: uxx + uyy = 4
double f(double x, double y)
{
    return 4.0;
}

int main()
{
    double a[5][5] = {0}, tol, h = 0.25;
    double x, y, oldValue;
    int i, j, k = 1, iteration = 0;

    cout << "Enter the tolerance error: " << endl;
    cin >> tol;


    // Boundary conditions
    for (i = 0; i <= 4; i++)
    {
        x = i * h;
        a[i][0] = x*x;
        a[i][4] = x*x + 1;
    }

    for (j = 0; j <= 4; j++)
    {
        y = j * h;
        a[0][j] = y*y;
        a[4][j] = 1 + y*y;
    }

    // Gauss-Seidel iterations
    while (k != 0 && iteration < 10000)
    {
        k = 0;

        for (i = 1; i <= 3; i++)
        {
            for (j = 1; j <= 3; j++)
            {
                x = i * h;
                y = j * h;

                oldValue = a[i][j];

                // Five-point formula
                a[i][j] = 0.25 * (a[i-1][j] + a[i+1][j]
                                  + a[i][j-1] + a[i][j+1]
                                  - h*h*f(x,y));

                if (!isfinite(a[i][j]))
                {
                    cout << "Numerical error!" << endl;
                    return 1;
                }

                if (fabs(a[i][j] - oldValue) > tol)
                {
                    k = 1;
                }
            }
        }

        iteration++;
    }

    if (k != 0)
    {
        cout << "Method did not converge!" << endl;
        return 1;
    }

    cout << "Number of iterations = "
         << iteration << endl;

    cout << "Solution of Poisson equation:" << endl;
    cout << fixed << setprecision(6);

    for (i = 0; i <= 4; i++)
    {
        for (j = 0; j <= 4; j++)
        {
            cout << setw(12) << a[i][j] << " ";
        }
        cout << endl;
    }

    return 0;
}
