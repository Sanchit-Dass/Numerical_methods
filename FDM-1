using namespace std;
double p(double x){
return 0.0;
}
double q(double x){
return 0.0;
}
double r(double x){
return -2.0;
}
 int main(){
  float x0,endx,y0,endy,h;
  int i,n;
  cout<<"enter number of subinterval:";
  cin>>n;
  cout<<"enter x0 and endx:";
  cin>>x0>>endx;
  cout<<"enter y0 and endy:";
  cin>>y0>>endy;
  h=(endx-x0)/n;
  int m=n-1;
  double A[50],B[50],C[50],D[50],alpha[50],beta[50],y[50];
 
  for(int j=0;j<m;j++){
  int i=j+1;
  double x=x0+i*h;
  double Pi=p(x);
  double Qi=q(x);
  double Ri=r(x);
  A[j]=1.0-h*Pi/2.0;
  B[j]=-2.0+h*h*Qi;
  C[j]=1.0+h*h*Qi;
  D[j]=h*h*Ri;
  D[0]=D[0]-A[0]*y0;
  D[m-1]=D[m-1]-C[m-1]*endy;
  A[0]=0.0;
  C[m-1]=0.0;}
 
  alpha[0]=B[0];
for(i=1;i<m;i++){
alpha[i]=B[i]-(A[i]*C[i-1])/alpha[i-1];
}
    beta[0]=D[0]/B[0];
    for(i=1;i<m;i++){
    beta[i]=(D[i]-(A[i]*beta[i-1]))/alpha[i];
}
y[m-1]=beta[m-1];
for(i=m-2;i>=0;i--){
y[i]=beta[i]-(C[i]*y[i+1])/alpha[i];
}
cout<<"the solution of equations are :"<<endl;
for(i=0;i<m;i++){
cout<<"y "<<i<<"= "<<y[i]<<endl;
}
return 0;

}
