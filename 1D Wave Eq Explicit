
#include <iostream>
#include <iomanip>
#include <cmath>
using namespace std;

int main()
{
    const int N = 4;       // Number of space intervals
    const int M = 10;      // Number of time steps
    const double pi = acos(-1.0);

    double c = 1.0;       // Wave speed
    double dx = 1.0 / N;
    double dt = 0.1;
    double r = c * dt / dx;

    // u[n][i] = displacement at time level n and position i
    double u[M+1][N+1] = {0};

    // Stability condition
    if (r > 1.0 || r <= 0.0)
    {
        cout << "System is Unstable or Invalid" << endl;
        return 1;
    }

    // Initial displacement: u(x,0) = sin(pi*x)
    // Initial velocity: u_t(x,0) = 0
    for (int i = 0; i <= N; i++)
    {
        double x = i * dx;
        u[0][i] = sin(pi * x);
    }

    // Boundary conditions
    u[0][0] = 0.0;
    u[0][N] = 0.0;

    // First time step
    for (int i = 1; i < N; i++)
    {
        u[1][i] = u[0][i] + 0.5 * r * r *
                  (u[0][i-1] - 2.0*u[0][i] + u[0][i+1]);
    }

    // Explicit finite difference method
    for (int n = 1; n < M; n++)
    {
        for (int i = 1; i < N; i++)
        {
            u[n+1][i] = 2.0*u[n][i] - u[n-1][i]
                        + r*r*(u[n][i-1] - 2.0*u[n][i]
                        + u[n][i+1]);
        }
    }

    // Print numerical solution
    cout << fixed << setprecision(4);
    cout << "r = " << r << endl;

    cout << "Time";
    for (int i = 0; i <= N; i++)
        cout << setw(10) << i*dx;

    cout << endl;

    for (int n = 0; n <= M; n++)
    {
        cout << setw(5) << n*dt;

        for (int i = 0; i <= N; i++)
        {
            cout << setw(10) << u[n][i];
        }

        cout << endl;
    }

    return 0;
}
