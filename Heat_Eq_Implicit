
#include <iostream>
#include <iomanip>
using namespace std;

int main()
{
    const int N = 4;       // Space intervals
    const int M = 10;      // Time steps

    double alpha = 1.0;
    double dx = 1.0 / N;
    double dt = 0.025;

    double r = alpha * dt / (dx * dx);

    // u[n][i] = temperature at time n, position i
    double u[M+1][N+1] = {0};

    // Arrays for Thomas algorithm
    double a[N+1], b[N+1], c[N+1], d[N+1];

    // Initial condition: u(x,0) = x(1-x)
    for (int i = 0; i <= N; i++)
    {
        double x = i * dx;
        u[0][i] = x * (1.0 - x);
    }

    // Implicit BTCS method
    for (int n = 0; n < M; n++)
    {
        // Boundary conditions
        u[n+1][0] = 0.0;
        u[n+1][N] = 0.0;

        // Form tridiagonal equations
        for (int i = 1; i < N; i++)
        {
            a[i] = -r;
            b[i] = 1.0 + 2.0*r;
            c[i] = -r;
            d[i] = u[n][i];
        }

        // Apply boundary values
        d[1] += r*u[n+1][0];
        d[N-1] += r*u[n+1][N];

        // Thomas algorithm: Forward elimination
        for (int i = 2; i < N; i++)
        {
            double factor = a[i]/b[i-1];

            b[i] = b[i] - factor*c[i-1];
            d[i] = d[i] - factor*d[i-1];
        }

        // Thomas algorithm: Back substitution
        u[n+1][N-1] = d[N-1]/b[N-1];

        for (int i = N-2; i >= 1; i--)
        {
            u[n+1][i] = (d[i] - c[i]*u[n+1][i+1])/b[i];
        }
    }

    // Print numerical solution
    cout << fixed << setprecision(4);
    cout << "r = " << r << endl;

    cout << "Time";

    for (int i = 0; i <= N; i++)
        cout << setw(10) << i*dx;

    cout << endl;

    for (int n = 0; n <= M; n++)
    {
        cout << setw(5) << n*dt;

        for (int i = 0; i <= N; i++)
        {
            cout << setw(10) << u[n][i];
        }

        cout << endl;
    }

    return 0;
}
